function drawMap() {
    for (let y = 0; y < map.length; y++) {
        for (let x = 0; x < map[y].length; x++) {

            const type = map[y][x];

            if (type === TILE.EMPTY) continue;

            const wx = x * GRID_SIZE;
            const wy = y * GRID_SIZE;

            const pos = worldToScreen(wx, wy);

            ctx.drawImage(
                images[type],
                pos.x,
                pos.y,
                GRID_SIZE * camera.scale,
                GRID_SIZE * camera.scale
            );
        }
    }
}
