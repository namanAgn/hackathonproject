}

function explodeOrb(orb) {
    spawnOrbExplosionEffect(orb.x, orb.y, orb.radius);
    damageBarrelsInRadius(orb.x, orb.y, orb.radius, orb.explosionDamage); 

    orb.markedEnemies.forEach(enemy => {
        enemy.health -= orb.explosionDamage;

        spawnFloatingText(
            enemy.x + enemy.w / 2,
            enemy.y,
            `-${orb.explosionDamage}`,
            "#fff"
        );

        const dx = enemy.x - orb.x;
        const dy = enemy.y - orb.y;

        const dist = Math.hypot(dx, dy);

        if (dist > 0) {
            enemy.knockback.x += ((dx / dist) * 20) / enemy.knockbackResistance;
            enemy.knockback.y += ((dy / dist) * 20) / enemy.knockbackResistance;
        }
    });
}

function separateEnemies(enemy) {
    let pushX = 0;
    let pushY = 0;

    enemies.forEach(other => {
        if (enemy === other) return;

        const dx = enemy.x - other.x;
        const dy = enemy.y - other.y;
        const dist = Math.hypot(dx, dy);

        const minDist = enemy.w;

        if (dist < minDist && dist > 0) {
            pushX += dx / dist;
            pushY += dy / dist;
        }
    });

    enemy.force.x += pushX * 0.5;
    enemy.force.y += pushY * 0.5;
}

function updateBullets() {
    for (let i = bullets.length - 1; i >= 0; i--) {
        const bullet = bullets[i];
        if (bullet.type === "rifle") {
    
            bullet.x += bullet.velocity.x;
            bullet.y += bullet.velocity.y;
    
            bullet.life--;
    
            if (bullet.life <= 0) {
                bullets.splice(i, 1);
                continue;
            }

            // --- WALL COLLISION CHECK START ---
            const gridX = Math.floor(bullet.x / GRID_SIZE);
            const gridY = Math.floor(bullet.y / GRID_SIZE);

            if (
                gridY < 0 || gridY >= map.length ||
                gridX < 0 || gridX >= map[0].length ||
                map[gridY][gridX] === 1 // Replace 1 with your wall tile value if different
            ) {
                bullets.splice(i, 1);
                continue; // Destroy bullet and skip enemy checks
            }

            for (let k = barrels.length - 1; k >= 0; k--) {
                const barrel = barrels[k];
                if (barrel.destroyed || barrel.health <= 0) continue;

                const bxw = barrel.x + BARREL_R * 2;
                const byw = barrel.y + BARREL_R * 2;
                const dist = Math.hypot(bxw - bullet.x, byw - bullet.y);

                if (dist < barrel.r + bullet.w / 2) {
                    barrel.health -= bullet.damage;
                    barrel.hitFlash = 0.3;
                    bullets.splice(i, 1);
                    continue; // skip to next bullet, since this one is consumed
                }
            }

            // --- WALL COLLISION CHECK END ---
    
            for (let j = enemies.length - 1; j >= 0; j--) {
                const enemy = enemies[j];
    
                const bx = bullet.x + bullet.w / 2;
                const by = bullet.y + bullet.h / 2;
    
                const ex = enemy.x + enemy.w / 2;
                const ey = enemy.y + enemy.h / 2;
    
                const dx = ex - bx;
                const dy = ey - by;
    
                const dist = Math.hypot(dx, dy);    
    
                if (dist < enemy.w / 2 + 16) { 
                    enemy.health -= bullet.damage;
                    damageDealt += bullet.damage;
                    enemy.hitFlash = 0.1;

                    enemy.knockback.x += (dx / dist) * 5;
                    enemy.knockback.y += (dy / dist) * 5;

                    spawnFloatingText(
                        enemy.x + enemy.w / 2,
                        enemy.y,
                        `-${bullet.damage}`,
                        "#fff"
                    );

                    
                    if (enemy.health <= 0) {
                        spawnDeathParticles(enemy);
                        enemies.splice(j, 1);
                        spawnDrop(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, enemy.focusReward || 30);
                        score += enemy.scoreReward;
                        enemiesKilled++;

                        spawnFloatingText(
                            enemy.x + enemy.w / 2,
                            enemy.y,
                            `+${enemy.scoreReward}`,
                            "#fde61c",
                            "score"
                        );

                        if (enemy.type === "splitter1") {
                            spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                            spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                            spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                        }
                        
                        if (enemy.type === "splitter2") {
                            spawnEnemyPredefined(enemy.x, enemy.y, "regular");
                            spawnEnemyPredefined(enemy.x, enemy.y, "regular");
                        }
                        
                        if (enemy.type === "splitter3") {
                            spawnEnemyPredefined(enemy.x, enemy.y, "regular");
                            spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                            spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                        }

                        if (enemy.type === "explosive") {
                            explode(enemy.x, enemy.y, enemy.explosiveRadius, enemy.explosiveDamage)
                        }           
                    }
    
                    bullets.splice(i, 1);
                    break;
                }
            }
        }
        else if (bullet.type === "rocket") {
            bullet.x += bullet.velocity.x;
            bullet.y += bullet.velocity.y;

            bullet.life--;

            const bx = bullet.x + bullet.w / 2;
            const by = bullet.y + bullet.h / 2;

            // --- LIFE EXPIRED ---
            if (bullet.life <= 0) {
                explode(bx, by, bullet.explosionRadius, bullet.explosionDamage);
                bullets.splice(i, 1);
                continue;
            }

            // --- WALL COLLISION ---
            const gridX = Math.floor(bx / GRID_SIZE);
            const gridY = Math.floor(by / GRID_SIZE);

            if (
                gridY < 0 || gridY >= map.length ||
                gridX < 0 || gridX >= map[0].length ||
                map[gridY][gridX] === TILE.WALL
            ) {
                explode(bx, by, bullet.explosionRadius, bullet.explosionDamage);
                bullets.splice(i, 1);
                continue;
            }

            // --- ENEMY COLLISION ---
            for (let j = enemies.length - 1; j >= 0; j--) {
                const enemy = enemies[j];
                const ex = enemy.x + enemy.w / 2;
                const ey = enemy.y + enemy.h / 2;

                const dist = Math.hypot(ex - bx, ey - by);

                if (dist < enemy.w / 2 + bullet.w / 2) {
                    explode(bx, by, bullet.explosionRadius, bullet.explosionDamage);
                    bullets.splice(i, 1);
                    break;
                }
            }
        }
    }
}

function spawnFloatingText(x, y, text, color = "white", type = "damage") {
    let life = 60;
    if (type === "focus") {
        y -= 30;
        life += 30;
    }

    if (type === "score") {
        y -= 60;
        life += 50;
    }

    damageTexts.push({
        x,
        y,
        text,
        color,
        life,
        velocityY: -1
    });
}

function triggerScreenShake(intensity = 15, duration = 12) {
    camera.shakeIntensity = intensity;
    camera.shakeDuration = duration;
}

function explode(x, y, radius = 280, damage = 160) {
    // 1. Trigger Screen Shake
    triggerScreenShake(18, 15);

    // 2. Spawn Expanding Shockwave Ring
    deathParticles.push({
        x: x,
        y: y,
        vx: 0,
        vy: 0,
        size: 10,
        targetSize: radius,
        life: 18,
        maxLife: 18,
        isShockwave: true,
        color: "#ffa500"
    });

    // 3. Dense Core Fire & Debris Particles (50 particles)
    const particleCount = 50;
    const colors = ["#ffffff", "#ffe600", "#ff6600", "#ff2200", "#444444"];

    for (let p = 0; p < particleCount; p++) {
        const angle = Math.random() * Math.PI * 2;
        // Higher speed spread for a larger blast radius
        const speed = 2 + Math.random() * 12;
        const particleColor = colors[Math.floor(Math.random() * colors.length)];

        deathParticles.push({
            x: x,
            y: y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            size: 6 + Math.random() * 14,
            angle: Math.random() * Math.PI * 2,
            spin: (Math.random() - 0.5) * 0.6,
            life: 20 + Math.floor(Math.random() * 20),
            maxLife: 40,
            color: particleColor
        });
    }

    damageBarrelsInRadius(x, y, radius, damage);

    const px = player.x + player.w / 2;
    const py = player.y + player.h / 2;

    const pdx = px - x;
    const pdy = py - y;
    const pDist = Math.hypot(pdx, pdy);

    if (pDist <= radius) {
        const playerDamageMultiplier = 0.3;
        const playerDamage = Math.max(1, Math.round(damage * (1 - pDist / radius) * playerDamageMultiplier));

        player.health -= playerDamage;
        damageReceived += playerDamage;
        player.hitFlash = 0.1;

        spawnFloatingText(px, player.y, `-${playerDamage}`, "#ff3333");

        // Optional: knockback the player too
        const pForce = 35 * (1 - pDist / radius);
        const pSafeDist = pDist || 1;
        const pnx = pdx / pSafeDist;
        const pny = pdy / pSafeDist;

        if (player.knockback) {
            player.knockback.x += pnx * pForce;
            player.knockback.y += pny * pForce;
        }
    }

    // 4. Damage & Knockback Logic
    for (let i = enemies.length - 1; i >= 0; i--) {
        const enemy = enemies[i];
        const ex = enemy.x + enemy.w / 2;
        const ey = enemy.y + enemy.h / 2;

        const dx = ex - x;
        const dy = ey - y;
        const dist = Math.hypot(dx, dy);

        if (dist > radius) continue;

        // Linear damage falloff
        const dealtDamage = Math.max(1, Math.round(damage * (1 - dist / radius)));

        enemy.health -= dealtDamage;
        enemy.hitFlash = 0.2;

        // Knockback calculation
        const force = 35 * (1 - dist / radius);
        const kRes = enemy.knockbackResistance || 1;

        const safeDist = dist || 1;
        const nx = dx / safeDist;
        const ny = dy / safeDist;

        enemy.knockback.x += (nx * force) / kRes;
        enemy.knockback.y += (ny * force) / kRes;

        spawnFloatingText(ex, enemy.y, `-${dealtDamage}`, "#ff6600");
        damageDealt += dealtDamage;

        if (enemy.health <= 0) {
            spawnDeathParticles(enemy);
            spawnDrop(ex, ey, enemy.focusReward || 30);
            score += enemy.scoreReward;
            enemiesKilled++;

            spawnFloatingText(ex, enemy.y, `+${enemy.scoreReward}`, "#fde61c", "score");

            // Splitter spawns
            if (enemy.type === "splitter1") {
                spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                spawnEnemyPredefined(enemy.x, enemy.y, "fast");
            } else if (enemy.type === "splitter2") {
                spawnEnemyPredefined(enemy.x, enemy.y, "regular");
                spawnEnemyPredefined(enemy.x, enemy.y, "regular");
            } else if (enemy.type === "splitter3") {
                spawnEnemyPredefined(enemy.x, enemy.y, "regular");
                spawnEnemyPredefined(enemy.x, enemy.y, "fast");
                spawnEnemyPredefined(enemy.x, enemy.y, "fast");
            }

            enemies.splice(i, 1);
        }
    }
}

function updateDamageTexts() {
    for (let i = damageTexts.length - 1; i >= 0; i--) {
        const text = damageTexts[i];

        text.y += text.velocityY;
        text.life--;

        if (text.life <= 0) {
            damageTexts.splice(i, 1);
        }
    }
}

function drawDamageTexts() {
    ctx.font = "bold 24px Montserrat";
    ctx.textAlign = "center";

    damageTexts.forEach(text => {
        const pos = worldToScreen(text.x, text.y);

        ctx.fillStyle = text.color;
        ctx.fillText(text.text, pos.x, pos.y);
    });
}

function drawCircle(wx, wy, r, color) {
    const p = worldToScreen(wx, wy);
    ctx.beginPath();
    ctx.arc(p.x, p.y, r * camera.scale, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();
}

// Generic AABB tile-collision check reused for both the player and enemies
function checkEntityTileCollision(entity) {
    const left = Math.floor(entity.x / GRID_SIZE);
    const right = Math.floor((entity.x + entity.w - 1) / GRID_SIZE);
    const top = Math.floor(entity.y / GRID_SIZE);
    const bottom = Math.floor((entity.y + entity.h - 1) / GRID_SIZE);

    for (let y = top; y <= bottom; y++) {
        for (let x = left; x <= right; x++) {
            if (map[y] && map[y][x] === TILE.WALL) {
                return true;
            }
        }
    }
    return false;
}

function updateEnemies() {
    const pCenter = { x: player.x + player.w / 2, y: player.y + player.h / 2 };
    const playerGrid = worldToGrid(pCenter.x, pCenter.y);

    enemies.forEach((enemy) => {
        const ex = enemy.x + enemy.w / 2;
        const ey = enemy.y + enemy.h / 2;

        const distToPlayer = Math.hypot(pCenter.x - ex, pCenter.y - ey);

        if (distToPlayer < player.w && time >= enemy.nextAttack) {
            player.health -= enemy.damage;
            damageReceived += enemy.damage;
            player.hitFlash = 0.1;
            enemy.nextAttack = time + enemy.cooldown;
        }

        // Recalculate path periodically or if there's no path
        enemy.pathTimer--;
        if (enemy.pathTimer <= 0) {
            const enemyGrid = worldToGrid(ex, ey);
            enemy.path = findPath(enemyGrid, playerGrid);
            enemy.pathTimer = 15;
        }

        let targetX = pCenter.x;
        let targetY = pCenter.y;

        // If a path was successfully calculated, move toward the next waypoint on the path
        if (enemy.path && enemy.path.length > 1) {
            const nextNode = enemy.path[1]; // Index 0 is the current grid position
            const waypointWorld = gridToWorld(nextNode.x, nextNode.y);
            
            targetX = waypointWorld.x;
            targetY = waypointWorld.y;

            // If we are already close enough to the waypoint, pop it off
            if (Math.hypot(waypointWorld.x - ex, waypointWorld.y - ey) < 10) {
                enemy.path.shift();
            }
        }

        let dx = targetX - ex;
        let dy = targetY - ey;
        const dist = Math.hypot(dx, dy);

        if (dist > 0) {
            dx /= dist;
            dy /= dist;
        }

        if (enemy.hitFlash > 0) {
            enemy.hitFlash -= 0.01;
        }
        
        enemy.angle = Math.atan2(pCenter.y - ey, pCenter.x - ex);
        enemy.velocity.x = dx * enemy.speed + enemy.force.x;
        enemy.velocity.y = dy * enemy.speed + enemy.force.y;

        enemy.force.x *= 0.9;
        enemy.force.y *= 0.9;

        // --- MOVE + WALL COLLISION (per-axis, same approach as the player) ---
        const moveX = enemy.velocity.x + enemy.knockback.x;
        const moveY = enemy.velocity.y + enemy.knockback.y;

        enemy.x += moveX;
        if (checkEntityTileCollision(enemy)) {
            enemy.x -= moveX;
            // Kill horizontal knockback so it doesn't keep pressing into the wall
            enemy.knockback.x = 0;
        }

        enemy.y += moveY;
        if (checkEntityTileCollision(enemy)) {
            enemy.y -= moveY;
            enemy.knockback.y = 0;
        }

        enemy.knockback.x *= 0.9;
        enemy.knockback.y *= 0.9;

        // --- KEEP ENEMIES FROM STACKING UNDERNEATH THE PLAYER ---
        // Push the enemy out along the player-to-enemy vector so it never
        // ends up rendered "under" the player sprite.
        const pDx = ex - pCenter.x;
        const pDy = ey - pCenter.y;
        const pDist = Math.hypot(pDx, pDy);
        const minPlayerDist = (enemy.w + player.w) / 2;

        if (pDist < minPlayerDist) {
            if (pDist > 0) {
                const pushX = (pDx / pDist) * (minPlayerDist - pDist);
                const pushY = (pDy / pDist) * (minPlayerDist - pDist);

                enemy.x += pushX;
                enemy.y += pushY;
            } else {
                // Enemy landed exactly on the player's center; nudge it away.
                enemy.x += minPlayerDist;
            }

            // Make sure the push-out didn't shove the enemy into a wall.
            if (checkEntityTileCollision(enemy)) {
                enemy.x -= (pDist > 0 ? (pDx / pDist) * (minPlayerDist - pDist) : minPlayerDist);
                enemy.y -= (pDist > 0 ? (pDy / pDist) * (minPlayerDist - pDist) : 0);
            }
        }
    });
}

function drawBullet(x, y, w, h, color, angle) {
    const center = worldToScreen(x + w / 2, y + h / 2);

    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(angle);
    ctx.scale(camera.scale, camera.scale);

    const r = h / 2;

    ctx.fillStyle = color;
    ctx.beginPath();

    ctx.moveTo(-w / 2, -r);

    ctx.lineTo(w / 2 - r, -r);

    ctx.arc(w / 2 - r, 0, r, -Math.PI / 2, Math.PI / 2);

    ctx.lineTo(-w / 2, r);

    ctx.closePath();
    ctx.fill();

    ctx.strokeStyle = "#a3952b";
    ctx.lineWidth = 2;

    ctx.beginPath();
    ctx.moveTo(w / 2 + 2 - r - 3, -r);
    ctx.lineTo(w / 2 + 2 - r - 3, r );
    ctx.stroke();

    ctx.restore();
}

function drawRocket(x, y, w, h, angle) {
    const center = worldToScreen(x + w / 2, y + h / 2);

    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(angle);
    ctx.scale(camera.scale, camera.scale);

    // Body
    ctx.fillStyle = "#777";
    ctx.fillRect(-w / 2 + 6, -h / 2, w - 12, h);

    // Nose cone
    ctx.fillStyle = "#d84343";
    ctx.beginPath();
    ctx.moveTo(w / 2, 0);
    ctx.lineTo(w / 2 - 10, -h / 2);
    ctx.lineTo(w / 2 - 10, h / 2);
    ctx.closePath();
    ctx.fill();

    // Rear nozzle
    ctx.fillStyle = "#444";
    ctx.fillRect(-w / 2, -h / 2 + 2, 6, h - 4);

    // Fins
    ctx.fillStyle = "#666";

    ctx.beginPath();
    ctx.moveTo(-w / 2 + 6, -h / 2);
    ctx.lineTo(-w / 2 - 5, -h);
    ctx.lineTo(-w / 2 + 10, -h / 2);
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(-w / 2 + 6, h / 2);
    ctx.lineTo(-w / 2 - 5, h);
    ctx.lineTo(-w / 2 + 10, h / 2);
    ctx.closePath();
    ctx.fill();

    // Yellow band
    ctx.fillStyle = "#d8c72d";
    ctx.fillRect(w / 2 - 20, -h / 2, 3, h);

    ctx.restore();
}

const ORB_CORE_COLOR = "#0d0614";
const ORB_GLOW_INNER = "#c084fc";
const ORB_GLOW_OUTER = "#7c3aed";
const ORB_RING_COLOR = "#d8b4fe";
const ORB_CHARGE_THRESHOLD = 0.25; // fraction of remaining life where the orb starts "charging up"

function drawOrb(bullet) {
    const lifePct = bullet.life / bullet.maxLife; // 1 (just spawned) -> 0 (about to explode)

    // Charge-up: grows rapidly in its final stretch of life as a visual warning
    let chargeScale = 1;
    if (lifePct < ORB_CHARGE_THRESHOLD) {
        const t = 1 - lifePct / ORB_CHARGE_THRESHOLD; // 0 -> 1 as it nears explosion
        chargeScale = 1 + t * t * 0.8;
    }

    // Subtle constant pulse so it never looks static
    const pulse = 1 + Math.sin(time * 14) * 0.05;
    const scale = chargeScale * pulse;

    const centerX = bullet.x + bullet.w / 2;
    const centerY = bullet.y + bullet.h / 2;
    const pos = worldToScreen(centerX, centerY);
    const baseR = (bullet.w / 2) * camera.scale;
    const r = baseR * scale;

    ctx.save();
    ctx.translate(pos.x, pos.y);

    // Outer glow (radial gradient fading to transparent)
    const gradient = ctx.createRadialGradient(0, 0, r * 0.15, 0, 0, r * 1.6);
    gradient.addColorStop(0, ORB_GLOW_INNER);
    gradient.addColorStop(0.45, ORB_GLOW_OUTER);
    gradient.addColorStop(1, "rgba(124, 58, 237, 0)");
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(0, 0, r * 1.6, 0, Math.PI * 2);
    ctx.fill();

    // Dark void core
    ctx.fillStyle = ORB_CORE_COLOR;
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.62, 0, Math.PI * 2);
    ctx.fill();

    // Two counter-rotating orbit rings for a "gravity well" feel
    ctx.strokeStyle = ORB_RING_COLOR;
    ctx.lineWidth = Math.max(1, 2 * camera.scale);
    ctx.globalAlpha = 0.8;

    ctx.save();
    ctx.rotate(time * 3.2);
    ctx.beginPath();
    ctx.ellipse(0, 0, r * 1.0, r * 0.38, 0, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    ctx.save();
    ctx.rotate(-time * 2.3 + Math.PI / 3);
    ctx.beginPath();
    ctx.ellipse(0, 0, r * 0.9, r * 0.32, 0, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    ctx.globalAlpha = 1;
    ctx.restore();
}

function drawBullets() {
    bullets.forEach(bullet => {
        if (bullet.type === "rifle") {
            drawBullet(bullet.x, bullet.y, bullet.w, bullet.h, BULLET_COLOR, bullet.angle);
        }
        else if (bullet.type === "orb") {
            drawOrb(bullet);
        }
        else if (bullet.type === "rocket") {
            drawRocket(bullet.x, bullet.y, bullet.w, bullet.h, bullet.angle);
        }
    });
}

function drawEnemyHealthBar(enemy) {
    const barWidth = enemy.w * 0.9;
    const barHeight = 7;
    const offsetY = 12; // gap above the enemy sprite

    const worldX = enemy.x + (enemy.w - barWidth) / 2;
    const worldY = enemy.y - offsetY - barHeight;

    const topLeft = worldToScreen(worldX, worldY);
    const w = barWidth * camera.scale;
    const h = barHeight * camera.scale;

    const pct = Math.max(0, Math.min(1, enemy.health / enemy.maxHealth));

    // Background
    ctx.fillStyle = "#000000aa";
    ctx.fillRect(topLeft.x - 1, topLeft.y - 1, w + 2, h + 2);

    // Fill color scales from green -> yellow -> red
    let fillColor;
    if (pct > 0.5) fillColor = "#4caf50";
    else if (pct > 0.2) fillColor = "#ffb300";
    else fillColor = "#f44336";

    ctx.fillStyle = fillColor;
    ctx.fillRect(topLeft.x, topLeft.y, w * pct, h);
}

// Traces the outline path for an enemy's shape (does not fill/stroke). Different
// enemy types get a distinct silhouette instead of a generic square + eyes.
function traceEnemyShape(enemy, w, h) {
    switch (enemy.type) {
        case "fast": {
            // Arrowhead: reads instantly as "fast, pointed at you"
            ctx.beginPath();
            ctx.moveTo(w * 0.52, 0);
            ctx.lineTo(-w * 0.38, -h * 0.42);
            ctx.lineTo(-w * 0.16, 0);
            ctx.lineTo(-w * 0.38, h * 0.42);
            ctx.closePath();
            break;  x``
        }
        case "explosive": {
            ctx.beginPath();
            ctx.moveTo(w * 0.52 * 1.5, 0);
            ctx.lineTo(-w * 0.38 * 1.5, -h * 0.42 * 1.5);
            ctx.lineTo(-w * 0.16 * 1.5, 0);
            ctx.lineTo(-w * 0.38 * 1.5, h * 0.42 * 1.5);
            ctx.closePath();
            break;
        }
        case "heavy": { 
            // Chunky octagon: bulky, armored feel
            const rx = w / 2, ry = h / 2;
            const cx = rx * 0.38, cy = ry * 0.38;
            ctx.beginPath();
            ctx.moveTo(-rx + cx, -ry);
            ctx.lineTo(rx - cx, -ry);
            ctx.lineTo(rx, -ry + cy);
            ctx.lineTo(rx, ry - cy);
            ctx.lineTo(rx - cx, ry);
            ctx.lineTo(-rx + cx, ry);
            ctx.lineTo(-rx, ry - cy);
            ctx.lineTo(-rx, -ry + cy);
            ctx.closePath();
            break;
        }
        case "splitter1":
        case "splitter2":
        case "splitter3": {
            // All splitters share the same diamond shape, scaled up
            // uniformly so they're bigger than the old splitter1 and
            // equal in size to one another.
            const scale = 1.35;
            const rx = (w / 2) * scale, ry = (h / 2) * scale;
            ctx.beginPath();
            ctx.moveTo(rx, 0);
            ctx.lineTo(0, -ry);
            ctx.lineTo(-rx, 0);
            ctx.lineTo(0, ry);
            ctx.closePath();
            break;
        }
        default: {
            // "regular": rounded square
            const radius = Math.min(w, h) * 0.18;
            roundRectPath(-w / 2, -h / 2, w, h, radius);
            break;
        }
    }
}

function drawEnemyBody(enemy) {
    const center = worldToScreen(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2);
    const w = enemy.w * camera.scale;
    const h = enemy.h * camera.scale;

    const lightColor = shadeColor(enemy.color, 28);
    const darkColor = shadeColor(enemy.color, -32);

    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(enemy.angle);

    traceEnemyShape(enemy, w, h);

    // Fill: gradient shading for a bit of 3D pop, flashes white on hit
    if (enemy.hitFlash > 0) {
        ctx.fillStyle = "#ffffff";
    } else {
        ctx.fillStyle = enemy.color;
    }
    ctx.fill();

    ctx.lineWidth = Math.max(1, 3 * camera.scale);
    ctx.strokeStyle = enemy.hitFlash > 0 ? "#ffffff" : darkColor;
    ctx.stroke();

    ctx.restore();
}

function drawEnemies() {
    enemies.forEach(enemy => {
        drawEnemyBody(enemy);
        drawEnemyHealthBar(enemy);
    });
}

