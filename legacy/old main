function worldToScreen(wx, wy) {
    return { x: wx * camera.scale + camera.x, y: wy * camera.scale + camera.y };
}

function screenToWorld(sx, sy) {
    return { x: (sx - camera.x) / camera.scale, y: (sy - camera.y) / camera.scale };
}

function lerp(a, b, t) { return a + (b - a) * t; }

function drawRect(x, y, w, h, color, angle = 0) {
    const center = worldToScreen(x + w / 2, y + h / 2);
    const scaledW = w * camera.scale;
    const scaledH = h * camera.scale;
    
    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(angle);
    ctx.fillStyle = color;
    ctx.fillRect(-scaledW / 2, -scaledH / 2, scaledW, scaledH);
    ctx.restore();
}

// Draws a rounded rectangle path (does not fill/stroke itself)
function roundRectPath(x, y, w, h, r) {
    r = Math.max(0, Math.min(r, w / 2, h / 2));
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
}

// Soft contact shadow drawn beneath moving entities for a bit of depth
function drawEntityShadow(x, y, w, h) {
    const center = worldToScreen(x + w / 2, y + h * 0.62);
    const rx = (w / 2) * 0.85 * camera.scale;
    const ry = (h / 2) * 0.32 * camera.scale;

    if (rx <= 0 || ry <= 0) return;

    ctx.save();
    ctx.beginPath();
    ctx.ellipse(center.x, center.y, rx, ry, 0, 0, Math.PI * 2);
    ctx.fillStyle = "rgba(0,0,0,0.35)";
    ctx.fill();
    ctx.restore();
}

// Lightens (positive percent) or darkens (negative percent) a hex color
function shadeColor(hex, percent) {
    const num = parseInt(hex.replace("#", ""), 16);
    const amt = Math.round(2.55 * percent);

    let r = (num >> 16) + amt;
    let g = (num >> 8 & 0x00ff) + amt;
    let b = (num & 0x0000ff) + amt;

    r = r < 255 ? (r < 0 ? 0 : r) : 255;
    g = g < 255 ? (g < 0 ? 0 : g) : 255;
    b = b < 255 ? (b < 0 ? 0 : b) : 255;

    return "#" + (0x1000000 + r * 0x10000 + g * 0x100 + b).toString(16).slice(1);
}

function drawGrid() {
    const step = GRID_SIZE * camera.scale;
    if (step < 3) return;
    const offsetX = ((camera.x % step) + step) % step;
    const offsetY = ((camera.y % step) + step) % step;
    ctx.strokeStyle = GRID_COLOR;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let x = offsetX; x < canvas.width; x += step) {
        ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, canvas.height);
    }
    for (let y = offsetY; y < canvas.height; y += step) {
        ctx.moveTo(0, y + 0.5); ctx.lineTo(canvas.width, y + 0.5);
    }
    ctx.stroke();
}

