// ---- deterministic per-cell "randomness" so tiles don't flicker each frame ----
function hashTile(x, y) {
    let h = (x * 374761393 + y * 668265263) | 0;
    h = (h ^ (h >>> 13)) * 1274126177;
    return (h ^ (h >>> 16)) >>> 0;
}
function tileVariant(x, y, count) {
    return hashTile(x, y) % count;
}

function damageBarrelsInRadius(x, y, radius, damage) {
    barrels.forEach(barrel => {
        if (barrel.destroyed || barrel.health <= 0) return;

        const bx = barrel.x + BARREL_R * 2;
        const by = barrel.y + BARREL_R * 2;
        const dist = Math.hypot(bx - x, by - y);

        if (dist < radius + barrel.r) {
            const dealt = Math.max(1, Math.round(damage * (1 - dist / radius)));
            barrel.health -= dealt;
            barrel.hitFlash = 0.3;
        }
    });
}
 
// ---- FLOOR TILES (sheet rows 1 & 2: light + slightly darker sets, 5 variants each) ----
const FLOOR_LIGHT = "#c6c6c6";
const FLOOR_DARK = "#a3a3a3";
const FLOOR_HILIGHT = "rgba(255,255,255,0.15)";
const FLOOR_SHADOW = "rgba(0,0,0,0.10)";
 
function drawFloorTile(gx, gy) {
    const wx = gx * GRID_SIZE, wy = gy * GRID_SIZE;
    const h = hashTile(gx, gy);
    const base = (h % 5 === 0) ? FLOOR_DARK : FLOOR_LIGHT; // occasional darker tile, like row 2
    const variant = Math.floor(h / 5) % 5;
 
    drawRect(wx, wy, GRID_SIZE, GRID_SIZE, base);
 
    const p = worldToScreen(wx, wy);
    const size = GRID_SIZE * camera.scale;
 
    ctx.save();
    // soft top highlight / bottom shadow bevel, present on every variant
    ctx.fillStyle = FLOOR_HILIGHT;
    ctx.fillRect(p.x, p.y, size, size * 0.12);
    ctx.fillStyle = FLOOR_SHADOW;
    ctx.fillRect(p.x, p.y + size * 0.85, size, size * 0.15);
 
    if (variant === 1) {
        // diagonal soft shadow band (matches tile #2 in the reference rows)
        ctx.fillStyle = FLOOR_SHADOW;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y + size * 0.15);
        ctx.lineTo(p.x + size * 0.6, p.y);
        ctx.lineTo(p.x + size, p.y);
        ctx.lineTo(p.x + size, p.y + size * 0.1);
        ctx.lineTo(p.x + size * 0.2, p.y + size * 0.35);
        ctx.closePath();
        ctx.fill();
    } else if (variant === 2) {
        ctx.fillStyle = FLOOR_HILIGHT;
        ctx.fillRect(p.x, p.y, size * 0.1, size);
    } else if (variant === 3) {
        ctx.fillStyle = FLOOR_SHADOW;
        ctx.fillRect(p.x + size * 0.9, p.y, size * 0.1, size);
    }
    ctx.restore();
}
 
// ---- MAP BORDER (the huge outer wall) ----
const MAP_BORDER_THICKNESS = 6; // how many tiles thick the outer wall ring is

const HAZARD_YELLOW = "#d4a017";
const HAZARD_DARK = "#1a1a1a";
const BORDER_WALL_BASE = "#2b2b2e";
const IMPASSABLE_ACCENT = "rgba(255, 176, 32, 0.5)"; // amber outline used on every solid tile

// shared "this blocks you" outline, used by walls/crates/border alike
function drawImpassableAccent(p, size) {
    ctx.save();
    ctx.strokeStyle = IMPASSABLE_ACCENT;
    ctx.lineWidth = Math.max(1, size * 0.025);
    ctx.strokeRect(p.x + size * 0.05, p.y + size * 0.05, size * 0.9, size * 0.9);
    ctx.restore();
}

// true for any cell inside the thick outer wall ring
function isBorderWall(gx, gy) {
    return (
        gx < MAP_BORDER_THICKNESS || gy < MAP_BORDER_THICKNESS ||
        gx >= map[0].length - MAP_BORDER_THICKNESS ||
        gy >= map.length - MAP_BORDER_THICKNESS
    );
}

// true only for the innermost ring of the border (the edge touching open floor)
// — this is where we paint the caution stripes so the boundary reads instantly
function isInnerBorderEdge(gx, gy) {
    const neighbors = [[gx + 1, gy], [gx - 1, gy], [gx, gy + 1], [gx, gy - 1]];
    return neighbors.some(([nx, ny]) => map[ny] && map[ny][nx] !== TILE.WALL);
}

function drawHazardStripes(p, size) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(p.x, p.y, size, size);
    ctx.clip();
    ctx.globalAlpha = 0.6;
    const stripeW = size * 0.22;
    ctx.translate(p.x + size / 2, p.y + size / 2);
    ctx.rotate(Math.PI / 4);
    for (let i = -3; i < 4; i++) {
        ctx.fillStyle = i % 2 === 0 ? HAZARD_YELLOW : HAZARD_DARK;
        ctx.fillRect(-size * 1.5, i * stripeW - size, size * 3, stripeW);
    }
    ctx.globalAlpha = 1;
    ctx.restore();
}

// ---- WALL TILES (sheet row 3: solid / vents / slats / vignette / solid) ----
const WALL_BASE = "#3c3c3c";
 
function drawWallTile(gx, gy) {
    const wx = gx * GRID_SIZE, wy = gy * GRID_SIZE;
    const variant = tileVariant(gx, gy, 5);

    drawRect(wx, wy, GRID_SIZE, GRID_SIZE, WALL_BASE);

    const p = worldToScreen(wx, wy);
    const size = GRID_SIZE * camera.scale;
    ctx.save();

    if (variant === 1) {
        ctx.fillStyle = "#54524f";
        for (let i = 0; i < 3; i++) {
            ctx.fillRect(p.x + size * 0.1, p.y + size * (0.28 + i * 0.16), size * 0.8, size * 0.06);
        }
    } else if (variant === 2) {
        ctx.fillStyle = "#57544f";
        ctx.fillRect(p.x + size * 0.38, p.y + size * 0.1, size * 0.06, size * 0.8);
        ctx.fillRect(p.x + size * 0.56, p.y + size * 0.1, size * 0.06, size * 0.8);
    } else if (variant === 3) {
        const grad = ctx.createRadialGradient(p.x + size / 2, p.y + size / 2, size * 0.1, p.x + size / 2, p.y + size / 2, size * 0.7);
        grad.addColorStop(0, "rgba(0,0,0,0)");
        grad.addColorStop(1, "rgba(0,0,0,0.35)");
        ctx.fillStyle = grad;
        ctx.fillRect(p.x, p.y, size, size);
    }

    ctx.strokeStyle = "rgba(0,0,0,0.5)";
    ctx.lineWidth = Math.max(1, size * 0.04);
    ctx.strokeRect(p.x, p.y, size, size);
    ctx.restore();

    drawImpassableAccent(p, size); // new: amber outline so it reads as solid at a glance
}
 
