function explodeWell(well) {
    spawnWellExplosionEffect(well.x, well.y, well.radius);
    damageBarrelsInRadius(well.x, well.y, well.radius, well.explosionDamage); 

    well.trappedEnemies.forEach(enemy => {
        enemy.health -= well.explosionDamage;
        damageDealt += well.explosionDamage;

        spawnFloatingText(
            enemy.x + enemy.w / 2,
            enemy.y,
            `-${well.explosionDamage}`,
            "#fff"
        );

        if (enemy.health <= 0) {
            spawnDeathParticles(enemy);
            enemies.splice(enemies.indexOf(enemy), 1);
            spawnDrop(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, enemy.focusReward || 30);
            score += enemy.scoreReward;
            enemiesKilled++;

            spawnFloatingText(
                enemy.x + enemy.w / 2,
                enemy.y,
                `+${enemy.scoreReward}`,
                "#fde61c",
                "score"
            );

            if (enemy.type === "explosive") {
                explode(enemy.x, enemy.y, enemy.explosiveRadius, enemy.explosiveDamage);
                triggerScreenShake(20, 15);
            }
        }

        const dx = enemy.x - well.x;
        const dy = enemy.y - well.y;

        const dist = Math.hypot(dx, dy);

        if (dist > 0) {
            enemy.knockback.x += ((dx / dist) * well.explosionForce) / enemy.knockbackResistance;
            enemy.knockback.y += ((dy / dist) * well.explosionForce) / enemy.knockbackResistance;
        }
    });
}

const WELL_CORE_COLOR = "#050208";
const WELL_GLOW_COLOR = "#3b0764";
const WELL_RING_COLOR = "#a855f7";
const WELL_SWELL_THRESHOLD = 0.3; // fraction of life remaining where it starts swelling toward detonation

function drawWellVisual(well) {
    const pos = worldToScreen(well.x, well.y);
    const baseR = WELL_RADIUS * camera.scale;

    const lifePct = well.life / well.maxLife; // 1 -> 0

    // Swell up as it approaches detonation, rather than changing color
    let swellScale = 1;
    if (lifePct < WELL_SWELL_THRESHOLD) {
        const t = 1 - lifePct / WELL_SWELL_THRESHOLD; // 0 -> 1 as it nears explosion
        swellScale = 1 + t * t * 0.9; // grows up to ~1.9x right before it pops
    }

    const pulse = 1 + Math.sin(time * 4) * 0.03;
    const r = baseR * swellScale * pulse;

    ctx.save();
    ctx.translate(pos.x, pos.y);

    // Accretion glow
    const gradient = ctx.createRadialGradient(0, 0, r * 0.12, 0, 0, r);
    gradient.addColorStop(0, "#1a0b2e");
    gradient.addColorStop(0.55, WELL_GLOW_COLOR);
    gradient.addColorStop(1, "rgba(59,7,100,0)");
    ctx.globalAlpha = 0.9;
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;

    // Dark event-horizon core
    ctx.fillStyle = WELL_CORE_COLOR;
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.28, 0, Math.PI * 2);
    ctx.fill();

    // Rotating dashed accretion rings, spin faster as it swells for extra tension
    ctx.strokeStyle = WELL_RING_COLOR;
    ctx.lineWidth = Math.max(1, 2 * camera.scale);
    ctx.setLineDash([r * 0.14, r * 0.1]);

    for (let i = 0; i < 3; i++) {
        const ringR = r * (0.45 + i * 0.18);
        const rotSpeed = (i % 2 === 0 ? 1 : -1) * (1.1 + i * 0.4) * swellScale;

        ctx.save();
        ctx.rotate(time * rotSpeed);
        ctx.globalAlpha = 0.75 - i * 0.18;
        ctx.beginPath();
        ctx.arc(0, 0, ringR, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
    }

    ctx.setLineDash([]);
    ctx.globalAlpha = 1;
    ctx.restore();
}

function drawWells() {
    wells.forEach(well => {
        drawWellVisual(well);
    });
}

