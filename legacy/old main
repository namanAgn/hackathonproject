function spawnDrop(x, y, value) {
    drops.push({
        x: x,
        y: y,
        value: value,
        size: 12,
        vx: (Math.random() - 0.5) * 4,
        vy: (Math.random() - 0.5) * 4,
        friction: 0.92,
        life: DROP_LIFE
    });
}

function updateDrops() {
    const px = player.x + player.w / 2;
    const py = player.y + player.h / 2;

    for (let i = drops.length - 1; i >= 0; i--) {
        const drop = drops[i];

        drop.life--;

        drop.x += drop.vx;
        drop.y += drop.vy;
        drop.vx *= drop.friction;
        drop.vy *= drop.friction;

        const dx = px - drop.x;
        const dy = py - drop.y;
        const dist = Math.hypot(dx, dy);

        const MAGNET_RADIUS = 150;
        if (dist < MAGNET_RADIUS && dist > 0) {
            drop.x += (dx / dist) * 6;
            drop.y += (dy / dist) * 6;
        }

        if (drop.life <= 0) {
            drops.splice(i, 1);
        }

        if (dist < player.w / 2 + drop.size) {
            if (focusCurrency === MAX_FOCUS || infiniteFocus) {
                score += drop.value / 2;
                spawnFloatingText(drop.x, drop.y, `+${drop.value / 2}`, "#fde61c", "score");
            }
            else {
                focusCurrency = infiniteFocus ? Infinity : Math.min(focusCurrency + drop.value, MAX_FOCUS);
                focusPicked += drop.value;
                spawnFloatingText(drop.x, drop.y, `+${drop.value}`, "#a855f7", "focus");
            }

            drops.splice(i, 1);
        }
    }
}

function createMinimap(map, width = 300, height = 300) {
    const minimap = document.createElement("canvas");
    const ctx = minimap.getContext("2d");

    minimap.width = width;
    minimap.height = height;

    const tileWidth = width / map[0].length;
    const tileHeight = height / map.length;

    for (let row = 0; row < map.length; row++) {
        for (let col = 0; col < map[row].length; col++) {

            switch (map[row][col]) {

                case 0: // Floor
                    ctx.fillStyle = "#777";
                    break;

                case 1: // Wall
                    ctx.fillStyle = "#222";
                    break;

                default:
                    ctx.fillStyle = "#777";
            }

            ctx.fillRect(
                col * tileWidth,
                row * tileHeight,
                tileWidth,
                tileHeight
            );
        }
    }

    return {
        canvas: minimap,
        scaleX: tileWidth,
        scaleY: tileHeight
    };
}

const minimap = createMinimap(map);

function drawMinimap() {
    const minimapX = canvas.width - minimap.canvas.width;
    const minimapY = canvas.height - minimap.canvas.height;

    ctx.drawImage(minimap.canvas, minimapX, minimapY);  

    ctx.fillStyle = "lime";
    ctx.beginPath();
    ctx.arc(
        minimapX + (player.x / GRID_SIZE) * minimap.scaleX,
        minimapY + (player.y / GRID_SIZE) * minimap.scaleY,
        3,
        0,
        Math.PI * 2
    );
    ctx.fill();

    ctx.fillStyle = "red";

    for (const enemy of enemies) {
        ctx.beginPath();
        ctx.arc(
            minimapX + (enemy.x / GRID_SIZE) * minimap.scaleX,
            minimapY + (enemy.y / GRID_SIZE) * minimap.scaleY,
            2,
            0,
            Math.PI * 2
        );
        ctx.fill();
    }

    ctx.fillStyle = "#8000ff";

    for (const well of wells) {
        ctx.beginPath();
        ctx.arc(
            minimapX + (well.x / GRID_SIZE) * minimap.scaleX,
            minimapY + (well.y / GRID_SIZE) * minimap.scaleY,
            4,
            0,
            Math.PI * 2
        );
        ctx.fill();
    }
}

function drawDrops() {
    drops.forEach(drop => {
        const pos = worldToScreen(drop.x, drop.y);
        const s = drop.size * camera.scale;

        ctx.save();
        ctx.translate(pos.x, pos.y);
        ctx.fillStyle = "#a855f7";
        ctx.shadowColor = "#c084fc";
        ctx.shadowBlur = 10 * camera.scale;

        ctx.beginPath();
        ctx.moveTo(0, -s);
        ctx.lineTo(s * 0.7, 0);
        ctx.lineTo(0, s);
        ctx.lineTo(-s * 0.7, 0);
        ctx.closePath();
        ctx.fill();

        ctx.restore();
    });
}

function regenHealthAndFocus() {
    if (time >= nextHealthRegenerationTime) {
        if (player.health < MAX_HEALTH) {
            player.health += 5;
            nextHealthRegenerationTime = time + HEALTH_REGEN_COOLDONW;
        }
        if (player.health + 5 > MAX_HEALTH) {
            player.health = godMode ? Infinity : MAX_HEALTH;
            nextHealthRegenerationTime = time + HEALTH_REGEN_COOLDONW;
        }
    }

    if (time >= nextFocusRegeneratonTime) {
        if (focusCurrency < MAX_FOCUS) {
            focusCurrency += 10;
            focusPicked += 10;
            nextFocusRegeneratonTime = time + FOCUS_REGEN_COOLDOWN;
        }
        if (focusCurrency + 10 > MAX_FOCUS) {
            focusPicked = MAX_FOCUS - focusCurrency;
            focusCurrency = infiniteFocus ? Infinity : MAX_FOCUS;
            nextFocusRegeneratonTime = time + FOCUS_REGEN_COOLDOWN;
        }
    }
}

