    });

    // Violet debris/energy burst
    const particleCount = 36;
    const colors = ["#f3e8ff", "#d8b4fe", "#c084fc", "#a855f7", "#7c3aed", "#3b0764"];

    for (let p = 0; p < particleCount; p++) {
