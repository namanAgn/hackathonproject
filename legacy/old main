function updatePlayer() {
    let dx = 0;
    let dy = 0;
    
    if (keys.w) dy--;
    if (keys.s) dy++;
    if (keys.a) dx--;
    if (keys.d) dx++;
    
    const len = Math.hypot(dx, dy);
    if (len > 0) {
        dx /= len;
        dy /= len;
    }

    if (player.hitFlash > 0) {
        player.hitFlash -= 0.01;
    }

    if (player.health <= 0) {
        gameOver = true;
    }
    
    player.velocity.x = dx * player.speed;
    player.velocity.y = dy * player.speed;
    
    // --- X Axis Collision ---
    player.x += player.velocity.x;
    if (checkTileCollision(player)) {
        player.x -= player.velocity.x;
    }

    // --- Y Axis Collision ---
    player.y += player.velocity.y;
    if (checkTileCollision(player)) {
        player.y -= player.velocity.y;
    }

    player.recoil *= 0.75;
    if (player.recoil < 0.05) {
        player.recoil = 0;
    }
    
    target.x = canvas.width / 2 - player.x * camera.scale;
    target.y = canvas.height / 2 - player.y * camera.scale;
}

