function aimPlayer() {
    const worldMouse = screenToWorld(mouse.x, mouse.y);

    const px = player.x + player.w / 2;
    const py = player.y + player.h / 2;

    const dx = worldMouse.x - px;
    const dy = worldMouse.y - py;

    const angle = Math.atan2(dy, dx);
    player.angle = angle;
}

function loop() {
    let targetCamX = lerp(camera.x, target.x, SMOOTHING);
    let targetCamY = lerp(camera.y, target.y, SMOOTHING);
    camera.scale = lerp(camera.scale, target.scale, SMOOTHING);

    if (camera.shakeDuration > 0) {
        camera.shakeDuration--;
        const offsetX = (Math.random() - 0.5) * camera.shakeIntensity;
        const offsetY = (Math.random() - 0.5) * camera.shakeIntensity;
        
        camera.x = targetCamX + offsetX;
        camera.y = targetCamY + offsetY;

        // Decay shake intensity over time
        camera.shakeIntensity *= 0.9;
    } else {
        camera.x = targetCamX;
        camera.y = targetCamY;
    }

    incrementTime();
    update();
    draw();

    requestAnimationFrame(loop);
}
