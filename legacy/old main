            }
        } 

        if (map[barrel.row][barrel.col] === TILE.BARREL_DESTROYED) {
            drawExplodedBarrel(barrel);
        }
    });
}

function updateBarrels() {
    barrels.forEach(barrel => {
        if (barrel.health > 0) {
            if (barrel.hitFlash > 0) {
                barrel.hitFlash -= 0.01;
            }
            return;
        }

        if (!barrel.destroyed) {
            explode(
                barrel.x + BARREL_R * 2,
                barrel.y + BARREL_R * 2,
                barrel.explosionRadius,
                barrel.explosionDamage
            );
            triggerScreenShake(50, 30);

            barrel.destroyed = true;
            map[barrel.row][barrel.col] = TILE.BARREL_DESTROYED;
            barrel.respawnTimer = BARREL_RESPAWN_TIME;
        }

        barrel.respawnTimer--;
        if (barrel.respawnTimer <= 0) {
            barrel.health = BARREL_HEALTH;
            map[barrel.row][barrel.col] = TILE.BARREL;
            barrel.destroyed = false;
            barrel.hitFlash = 0;
        }
    });
}



// ---- CRATE TILES (sheet row 4: ridged / banded / two-tone / gradient / solid) ----
const CRATE_BASE = "#333330";
 
function drawCrateTile(gx, gy) {
    const wx = gx * GRID_SIZE, wy = gy * GRID_SIZE;
    const variant = tileVariant(gx, gy, 5);
 
    drawRect(wx, wy, GRID_SIZE, GRID_SIZE, CRATE_BASE);
 
    const p = worldToScreen(wx, wy);
    const size = GRID_SIZE * camera.scale;
    ctx.save();
 
    if (variant === 0) {
        // vertical ridges
        ctx.fillStyle = "#4a4842";
        for (let i = 0; i < 4; i++) {
            ctx.fillRect(p.x + size * (0.12 + i * 0.2), p.y + size * 0.1, size * 0.08, size * 0.8);
        }
    } else if (variant === 1) {
        // horizontal bands
        ctx.fillStyle = "#4a4842";
        for (let i = 0; i < 4; i++) {
            ctx.fillRect(p.x + size * 0.1, p.y + size * (0.12 + i * 0.2), size * 0.8, size * 0.08);
        }
    } else if (variant === 2) {
        // two-tone marker panel
        ctx.fillStyle = "#a85a3c";
        ctx.fillRect(p.x, p.y, size * 0.45, size);
    } else if (variant === 3) {
        // rust gradient panel
        const grad = ctx.createLinearGradient(p.x, p.y, p.x + size, p.y + size);
        grad.addColorStop(0, "#8a4a34");
        grad.addColorStop(1, "#5c3020");
        ctx.fillStyle = grad;
        ctx.fillRect(p.x, p.y, size, size);
    }
 
    ctx.strokeStyle = "rgba(0,0,0,0.4)";
    ctx.lineWidth = Math.max(1, size * 0.03);
    ctx.strokeRect(p.x, p.y, size, size);
    ctx.restore();
    drawImpassableAccent(worldToScreen(gx * GRID_SIZE, gy * GRID_SIZE), GRID_SIZE * camera.scale);
}

function drawBorderWallTile(gx, gy) {
    const wx = gx * GRID_SIZE, wy = gy * GRID_SIZE;
    drawRect(wx, wy, GRID_SIZE, GRID_SIZE, BORDER_WALL_BASE);

    const p = worldToScreen(wx, wy);
    const size = GRID_SIZE * camera.scale;
    ctx.save();

    // inset panel + top highlight, for a thick bunker-wall look
    ctx.fillStyle = "rgba(0,0,0,0.25)";
    ctx.fillRect(p.x + size * 0.08, p.y + size * 0.08, size * 0.84, size * 0.84);
    ctx.fillStyle = "rgba(255,255,255,0.06)";
    ctx.fillRect(p.x, p.y, size, size * 0.08);

    // corner rivets
    ctx.fillStyle = "rgba(255,255,255,0.14)";
    const rivetR = size * 0.045;
    [[0.18, 0.18], [0.82, 0.18], [0.18, 0.82], [0.82, 0.82]].forEach(([rx, ry]) => {
        ctx.beginPath();
        ctx.arc(p.x + size * rx, p.y + size * ry, rivetR, 0, Math.PI * 2);
        ctx.fill();
    });

    ctx.strokeStyle = "rgba(0,0,0,0.6)";
    ctx.lineWidth = Math.max(1, size * 0.05);
    ctx.strokeRect(p.x, p.y, size, size);
    ctx.restore();

    // caution stripes only on the ring of border tiles actually touching floor
    if (isInnerBorderEdge(gx, gy)) {
        drawHazardStripes(p, size);
    }
}
 
// ---- updated drawMap using the textured tiles above ----
function drawMap() {
    for (let y = 0; y < map.length; y++) {
        for (let x = 0; x < map[y].length; x++) {
            const t = map[y][x];
            if (t === TILE.WALL) {
                if (isBorderWall(x, y)) {
                    drawBorderWallTile(x, y);
                } else {
                    drawWallTile(x, y);
                }
            } else if (t === TILE.CRATE) {
                drawCrateTile(x, y);
            } else {
                drawFloorTile(x, y);
            }
        }
    }
}

function generateMap(width = 80, height = 40) {
    const newMap = [];

    for (let y = 0; y < height; y++) {
        const row = [];
        for (let x = 0; x < width; x++) {
            const border =
                x < MAP_BORDER_THICKNESS || y < MAP_BORDER_THICKNESS ||
                x >= width - MAP_BORDER_THICKNESS || y >= height - MAP_BORDER_THICKNESS;
            row.push(border ? TILE.WALL : TILE.FLOOR);
        }
        newMap.push(row);
    }

    const innerW = width - MAP_BORDER_THICKNESS * 2;
    const innerH = height - MAP_BORDER_THICKNESS * 2;

    // interior wall clusters — bigger and more numerous for the larger map
    const wallClusters = 28 + Math.floor(Math.random() * 15);
    for (let i = 0; i < wallClusters; i++) {
        const cx = MAP_BORDER_THICKNESS + 1 + Math.floor(Math.random() * (innerW - 6));
        const cy = MAP_BORDER_THICKNESS + 1 + Math.floor(Math.random() * (innerH - 5));
        const w = 1 + Math.floor(Math.random() * 6); // up to 6 tiles wide
        const h = 1 + Math.floor(Math.random() * 4); // up to 4 tiles tall
        for (let yy = cy; yy < Math.min(height - MAP_BORDER_THICKNESS, cy + h); yy++) {
            for (let xx = cx; xx < Math.min(width - MAP_BORDER_THICKNESS, cx + w); xx++) {
                newMap[yy][xx] = TILE.WALL;
            }
        }
    }

    // decorative crates, scattered more densely across the bigger floor
    const crateCount = 45 + Math.floor(Math.random() * 25);
    for (let i = 0; i < crateCount; i++) {
        const x = MAP_BORDER_THICKNESS + Math.floor(Math.random() * innerW);
        const y = MAP_BORDER_THICKNESS + Math.floor(Math.random() * innerH);
        if (newMap[y][x] === TILE.FLOOR) newMap[y][x] = TILE.CRATE;
    }

    // explosive barrels — more of them, spread across the whole map
    const barrelCount = 28 + Math.floor(Math.random() * 15);
    let placed = 0, attempts = 0;
    while (placed < barrelCount && attempts < 800) {
        attempts++;
        const x = MAP_BORDER_THICKNESS + Math.floor(Math.random() * innerW);
        const y = MAP_BORDER_THICKNESS + Math.floor(Math.random() * innerH);
        if (newMap[y][x] === TILE.FLOOR) {
            newMap[y][x] = TILE.BARREL;
            placed++;
        }
    }

    return newMap;
}

const map = generateMap(80, 40);

function worldToGrid(x, y) {
    return {
        x: Math.floor(x / GRID_SIZE),
        y: Math.floor(y / GRID_SIZE)
    };
}

function gridToWorld(x, y) {
    return {
        x: x * GRID_SIZE + GRID_SIZE / 2,
        y: y * GRID_SIZE + GRID_SIZE / 2
    };
}

function reconstructPath(cameFrom, current) {
    const key = p => `${p.x},${p.y}`;
    const totalPath = [current];
    let currentKey = key(current);
    while (currentKey in cameFrom) {
        current = cameFrom[currentKey];
        currentKey = key(current);
        totalPath.unshift(current);
    }
    return totalPath;
}

function findPath(start, end) {
    const open = [start];
    const cameFrom = {};

    const key = p => `${p.x},${p.y}`;

    const cost = {};
    cost[key(start)] = 0;

    while (open.length > 0) {
        open.sort((a,b) => cost[key(a)] - cost[key(b)]);

        const current = open.shift();

        if (current.x === end.x && current.y === end.y) {
            return reconstructPath(cameFrom, current);
        }

        const neighbors = [
            {x: current.x + 1, y: current.y},
            {x: current.x - 1, y: current.y},
            {x: current.x, y: current.y + 1},
            {x: current.x, y: current.y - 1},
        ];

        for (const next of neighbors) {
            // Ensure node is inside map bounds and is a floor tile (0)
            if (
                next.y < 0 || next.y >= map.length ||
                next.x < 0 || next.x >= map[0].length ||
                (
                    map[next.y][next.x] !== TILE.FLOOR &&
                    map[next.y][next.x] !== TILE.BARREL_DESTROYED &&
                    !(next.x === end.x && next.y === end.y)
                )
            ) {
                continue;
            }

            const newCost = cost[key(current)] + 1;
            if (cost[key(next)] === undefined || newCost < cost[key(next)]) {
                cost[key(next)] = newCost;
                open.push(next);
                cameFrom[key(next)] = current;
            }
        }
    }

    return [];
}

