        knockbackResistance: enemyKnockbackResistance,
        
        path: [],
        pathTimer: 0
    };

    enemies.push(enemy);
}

function spawnEnemy() {
    let type;

    const r = Math.random();

    if (r < 0.35) {
        type = "regular";      // 35%
    } else if (r < 0.55) {
        type = "fast";         // 20%
    } else if (r < 0.70) {
        type = "explosive";        // 15%
    } else if (r < 0.78) {
        type = "splitter1";    // 8%
    } else if (r < 0.85) {
        type = "splitter2";    // 7%
    } else if (r < 0.91) {
        type = "splitter3";    // 6%
    } else if (r < 0.97) {
        type = "heavy";    // 6%
    } else {
        type = "regular";      // 3%
    }

    const enemyHealth = ENEMY_CONFIGS[type].health;
    const enemySpeed = ENEMY_CONFIGS[type].speed;
    const enemyDamage = ENEMY_CONFIGS[type].damage;
    const enemyW = ENEMY_CONFIGS[type].w;
    const enemyH = ENEMY_CONFIGS[type].h;
    const enemyColor = ENEMY_CONFIGS[type].color;
    const enemyAttackCooldown = ENEMY_CONFIGS[type].attackCooldown;
    const enemyFocusReward = ENEMY_CONFIGS[type].focusReward;
    const enemyScoreReward = ENEMY_CONFIGS[type].scoreReward;
    const enemyGravityResistance = ENEMY_CONFIGS[type].gravityResistance;
    const enemyKnockbackResistance = ENEMY_CONFIGS[type].knockbackResistance;

    // Pick a random open tile on the map for spawning to prevent spawning inside walls
    const openTiles = [];
    for (let y = 0; y < map.length; y++) {
        for (let x = 0; x < map[y].length; x++) {
            if (map[y][x] === 0) {
                openTiles.push({ x, y });
            }
        }
    }

    const MIN_SPAWN_DISTANCE = 800;

    let spawnX = player.x + MIN_SPAWN_DISTANCE;
    let spawnY = player.y;

    if (openTiles.length > 0) {
        let found = false;

        for (let attempts = 0; attempts < 100; attempts++) {
            const tile = openTiles[Math.floor(Math.random() * openTiles.length)];
            const worldPos = gridToWorld(tile.x, tile.y);

            const dx = worldPos.x - player.x;
            const dy = worldPos.y - player.y;

            if (dx * dx + dy * dy >= MIN_SPAWN_DISTANCE * MIN_SPAWN_DISTANCE) {
                spawnX = worldPos.x - enemyW / 2;
                spawnY = worldPos.y - enemyH / 2;
                found = true;
                break;
            }
        }

        // Fallback if no distant tile was found
        if (!found) {
            const tile = openTiles[Math.floor(Math.random() * openTiles.length)];
            const worldPos = gridToWorld(tile.x, tile.y);
            spawnX = worldPos.x - enemyW / 2;
            spawnY = worldPos.y - enemyH / 2;
        }
    }

    const enemy = {
        type,
        x: spawnX,
        y: spawnY,

        velocity: {
            x: 0,
            y: 0
        },

        force: {
            x: 0,
            y: 0
        },

        knockback: {
            x: 0,
            y: 0
        },

        speed: enemySpeed,
        health: enemyHealth,
        maxHealth: enemyHealth,
        w: enemyW,
        h: enemyH,
        color: enemyColor,
        angle: 0,
        hitFlash: 0,
        damage: enemyDamage,
        cooldown: enemyAttackCooldown,
        nextAttack: 0,
        focusReward: enemyFocusReward,
        scoreReward: enemyScoreReward,
        gravityResistance: enemyGravityResistance,
        knockbackResistance: enemyKnockbackResistance,
        
        path: [],
        pathTimer: 0
    };

    if (enemy.type === "explosive") {
        enemy.explosiveRadius = ENEMY_CONFIGS[enemy.type].explosiveRadius;
        enemy.explosiveDamage = ENEMY_CONFIGS[enemy.type].explosiveDamage;
    }

    enemies.push(enemy);
}

function spawnTool() {
    if (selectedTool === "rifle") {
        if (mouse.left && time >= nextShotTime && focusCurrency >= RIFLE_COST) {
            focusCurrency -= RIFLE_COST;
            spawnBullet();
            nextShotTime = time + BULLET_SPAWN_COOLDOWN;
        }
    }

    if (selectedTool === "orb") {
        if (mouse.left && time >= nextShotTime && focusCurrency >= ORB_COST) {
            focusCurrency -= ORB_COST;
            spawnBullet();
            nextShotTime = time + BULLET_SPAWN_COOLDOWN;
        }
    }

    if (selectedTool === "rocket") {
        if (mouse.left && time >= nextRocketShootTime && focusCurrency >= ROCKET_COST) {
            focusCurrency -= ROCKET_COST;
            spawnBullet();
            nextRocketShootTime = time + ROCKET_SPAWN_COOLDOWN;
        }
    }
    
    if (selectedTool === "well") {
        if (mouse.left && time >= nextShotTime && focusCurrency >= WELL_COST) {
            const worldMouse = screenToWorld(mouse.x, mouse.y);
            focusCurrency -= WELL_COST;
            spawnWell(worldMouse.x, worldMouse.y);
            nextShotTime = time + BULLET_SPAWN_COOLDOWN;
        }
    }
}

function updateOrbs() {
    for (let i = bullets.length - 1; i >= 0; i--) {
        const orb = bullets[i];
        if (orb.type === "orb") {
            orb.x += orb.velocity.x;
            orb.y += orb.velocity.y;

            orb.life--;
        }

        enemies.forEach(enemy => {
            const ex = enemy.x + enemy.w / 2;
            const ey = enemy.y + enemy.h / 2;

            let dx = orb.x - ex;
            let dy = orb.y - ey;

            const dist = Math.hypot(dx, dy);

            if (dist < orb.radius && dist > 0) {

                dx /= dist;
                dy /= dist;

                enemy.force.x += dx * orb.pullStrength / enemy.gravityResistance;
                enemy.force.y += dy * orb.pullStrength / enemy.gravityResistance;

                if (!orb.markedEnemies.includes(enemy)) {
                    orb.markedEnemies.push(enemy);
                }
            }
        });


        if (orb.life <= 0) {
            explodeOrb(orb);
            triggerScreenShake(20, 15);
            bullets.splice(i, 1);
        }
    }
}

function spawnOrbExplosionEffect(x, y, radius) {
    // Expanding shockwave ring
    deathParticles.push({
        x: x,
        y: y,
