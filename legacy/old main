function drawPlayer() {
    if (selectedTool === "rifle") {
        drawRifle(player.x, player.y, player.angle);
    }

    if (selectedTool === "rocket") {
        drawRocketLauncher(player.x, player.y, player.angle);
    }

    drawEntityShadow(player.x, player.y, player.w, player.h);

    const center = worldToScreen(player.x + player.w / 2, player.y + player.h / 2);
    const w = player.w * camera.scale;
    const h = player.h * camera.scale;
    const radius = Math.min(w, h) * 0.22;

    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(player.angle);

    // Hit-flash flare: a soft red glow behind the body that fades quickly
    if (player.hitFlash > 0) {
        ctx.save();
        ctx.globalAlpha = Math.min(1, player.hitFlash * 7);
        ctx.fillStyle = "#ff4d4d";
        roundRectPath(-w / 2 - 8, -h / 2 - 8, w + 16, h + 16, radius + 6);
        ctx.fill();
        ctx.restore();
    }

    // Body: light gradient, subtle steel-blue outline
    const grad = ctx.createLinearGradient(-w / 2, -h / 2, w / 2, h / 2);
    grad.addColorStop(0, "#44ff00");
    grad.addColorStop(1, "#5fc14d");
    ctx.fillStyle = grad;
    roundRectPath(-w / 2, -h / 2, w, h, radius);
    ctx.fill();

    ctx.lineWidth = Math.max(1, 3 * camera.scale);
    ctx.strokeStyle = "#266b31";
    roundRectPath(-w / 2, -h / 2, w, h, radius);
    ctx.stroke();

    ctx.restore();
}

