function spawnDeathParticles(enemy) {
    const count = 14;

    const cx = enemy.x + enemy.w / 2;
    const cy = enemy.y + enemy.h / 2;

    for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 5;
        const size = 4 + Math.random() * 6;

        deathParticles.push({
            x: cx,
            y: cy,

            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,

            size,
            angle: Math.random() * Math.PI * 2,
            spin: (Math.random() - 0.5) * 0.35,

            life: 30,
            maxLife: 30,

            color: enemy.color
        });
    }
}

function updateDeathParticles() {
    for (let i = deathParticles.length - 1; i >= 0; i--) {
        const p = deathParticles[i];

        p.x += p.vx;
        p.y += p.vy;

        p.vx *= 0.95;
        p.vy *= 0.95;

        p.vy += 0.08;

        p.angle += p.spin;

        p.life--;

        if (p.life <= 0) {
            deathParticles.splice(i, 1);
        }
    }
}

function drawDeathParticles() {
    deathParticles.forEach(p => {
        const alpha = p.life / p.maxLife;
        const pos = worldToScreen(p.x, p.y);

        ctx.save();
        ctx.globalAlpha = Math.max(0, alpha);

        if (p.isShockwave) {
            // Expand shockwave radius based on remaining life
            const currentRadius = lerp(p.targetSize, p.size, p.life / p.maxLife) * camera.scale;
            ctx.strokeStyle = p.color;
            ctx.lineWidth = 6 * camera.scale * alpha;
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, currentRadius, 0, Math.PI * 2);
            ctx.stroke();
        } else {
            // Standard particles
            ctx.translate(pos.x, pos.y);
            ctx.rotate(p.angle);
            ctx.scale(camera.scale, camera.scale);

            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        }

        ctx.restore();
    });

    ctx.globalAlpha = 1;
}

function updateWells() {
    for (let i = wells.length - 1; i >= 0; i--) {
        const well = wells[i];

        well.life--;

        enemies.forEach(enemy => {
            const ex = enemy.x + enemy.w / 2;
            const ey = enemy.y + enemy.h / 2;

            let dx = well.x - ex;
            let dy = well.y - ey;

            const dist = Math.hypot(dx, dy);

            if (dist < well.radius && dist > 0) {
                dx /= dist;
                dy /= dist;

                enemy.force.x += dx * well.pullStrength / enemy.gravityResistance;
                enemy.force.y += dy * well.pullStrength / enemy.gravityResistance;

                if (!well.trappedEnemies.includes(enemy)) {
                    well.trappedEnemies.push(enemy);
                }
            }
        });

        if (well.life <= 0) {
            explodeWell(well);
            triggerScreenShake(30, 30);
            wells.splice(i, 1);
        }
    }
}

